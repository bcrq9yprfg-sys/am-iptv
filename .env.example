# ── AM IPTV — Environment Variables ──────────────────────────────────────────
# Kopieer dit bestand naar .env en vul alle waarden in.
# Commit NOOIT .env naar git.

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# De publieke URL van jouw Railway-deployment (zonder trailing slash)
# Voorbeeld: https://am-iptv-production.up.railway.app
BASE_URL=https://jouw-app.up.railway.app

# ── Database ───────────────────────────────────────────────────────────────────
# Pad naar het SQLite-bestand. Op Railway: gebruik een volume mount.
# Standaard: ./data/amiptv.db (wordt aangemaakt als het niet bestaat)
DB_PATH=./data/amiptv.db

# ── Beveiliging ────────────────────────────────────────────────────────────────
# Willekeurige string van ≥32 tekens — genereer met: openssl rand -hex 32
JWT_SECRET=vervang_dit_met_een_lange_willekeurige_string

# ── Stripe ─────────────────────────────────────────────────────────────────────
# Haal deze op via https://dashboard.stripe.com/apikeys (live modus)
STRIPE_SECRET_KEY=sk_live_...

# Haal op via Stripe Dashboard → Webhooks → jouw endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — maak producten aan in Stripe Dashboard → Products
# Product: "AM IPTV 6 Maanden"  → Prijs: €9,99 eenmalig
STRIPE_PRICE_6M=price_...

# Product: "AM IPTV 1 Jaar"  → Prijs: €16,99 eenmalig
STRIPE_PRICE_1Y=price_...

# Product: "AM IPTV Onbeperkt"  → Prijs: €29,99 eenmalig
STRIPE_PRICE_UNLIMITED=price_...
